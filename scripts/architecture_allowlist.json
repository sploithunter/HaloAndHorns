      "disposition": "migration-debt",
      "files": {},
      "owner": "gameplay events",
      "pattern": "Signals.GameEvent:FireClient|FireAllClients",
      "reason": "Existing direct sends must migrate behind the authoritative gameplay-event publisher."
    },
