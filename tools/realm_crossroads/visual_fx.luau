-- Edit installer: require(installer)(world, decodedConfig, decodedBundle).
-- Source files are named by config. No network, live gameplay or runtime Source writes.
-- Production must copy the generated ReplicatedStorage folder and client companion,
-- adapt config.world/owner paths, and bridge existing graphics preferences to the
-- configured player attributes. This installer itself is restricted to PlaceId 0.
return function(world, cfg, bundle)
    assert(
        game.PlaceId == 0 and not game:GetService("RunService"):IsRunning(),
        "Local Edit preview only"
    )
    assert(world == workspace:FindFirstChild(cfg.world), "Wrong Crossroads world")
    assert(cfg.version == 1 and bundle.version == 1, "Unsupported visual FX version")
    assert(
        type(bundle.modules.AmbientField) == "string"
            and type(bundle.modules.AmbientConfig) == "string",
        "Missing ambient modules"
    )
    assert(cfg.update_interval > 0, "Invalid FX update interval")
    local function resolve(root, path)
        for _, name in ipairs(path) do
            root = root and root:FindFirstChild(name)
        end
        return root
    end
    for _, field in ipairs(cfg.fields) do
        assert(resolve(world, field.owner_path), "Missing FX anchor " .. field.name)
        assert(bundle.presets[field.preset], "Missing FX preset " .. field.preset)
    end
    local storage = game:GetService("ReplicatedStorage")
    local starter = game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts")
    local runtime = Instance.new("Folder")
    runtime.Name = cfg.runtime_root
    runtime:SetAttribute("CosmeticOnly", true)
    runtime:SetAttribute("BundleProvenance", cfg.bundle_provenance)
    for _, name in ipairs({ "AmbientConfig", "AmbientField", "RippleTimeline", "WaterRipple" }) do
        local module = Instance.new("ModuleScript")
        module.Name = name
        module.Source = bundle.modules[name]
        module.Parent = runtime
    end
    local data = Instance.new("StringValue")
    data.Name = "ConfigJSON"
    data.Value = game:GetService("HttpService"):JSONEncode({
        integration = cfg,
        schema = bundle.schema,
        presets = bundle.presets,
        ripple = bundle.ripple,
    })
    data.Parent = runtime
    local client = Instance.new("LocalScript")
    client.Name = cfg.client_name
    client:SetAttribute("RuntimeRoot", cfg.runtime_root)
    client.Source = [==[
-- Native client companion generated by the Edit-only Crossroads FX installer.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local storage = game:GetService("ReplicatedStorage")
local runtime = storage:WaitForChild(script:GetAttribute("RuntimeRoot"))
local data = HttpService:JSONDecode(runtime:WaitForChild("ConfigJSON").Value)
local cfg = data.integration
local AmbientField = require(runtime:WaitForChild("AmbientField"))
local player = Players.LocalPlayer
local settings = UserSettings():GetService("UserGameSettings")
local root = Instance.new("Folder")
root.Name = cfg.local_root
root:SetAttribute("CosmeticOnly", true)
root.Parent = workspace
local handles, connections = {}, {}
local elapsed, stopped = 0, false
local function resolve(parent, path)
    for _, name in ipairs(path) do
        parent = parent and parent:FindFirstChild(name)
    end
    return parent
end
local function clone(value)
    if type(value) ~= "table" then
        return value
    end
    local result = {}
    for key, item in pairs(value) do
        result[key] = clone(item)
    end
    return result
end
local function quality()
    local override = player:GetAttribute(cfg.quality_attribute)
    if type(override) == "string" and data.schema.qualities[override] ~= nil then
        return override
    end
    local level = settings.SavedQualityLevel.Value
    if level > 0 then
        for _, tier in ipairs(cfg.graphics_tiers) do
            if level <= tier.maximum then
                return tier.quality
            end
        end
    end
    return cfg.default_quality
end
local function cleanup()
    if stopped then
        return
    end
    stopped = true
    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
    for _, item in pairs(handles) do
        item.handle:destroy()
    end
    table.clear(handles)
    root:Destroy()
end
local function attach(field, owner)
    local preset = clone(data.presets[field.preset])
    preset.name = field.name
    if field.placement == "gate_ground_frame" then
        if not owner:IsA("BasePart") then
            return nil
        end
        local frame = CFrame.new(owner.Position.X, field.ground_y, owner.Position.Z)
            * owner.CFrame.Rotation
        local offset = Vector3.new(unpack(field.offset))
        local origin = frame:PointToWorldSpace(offset)
        preset.origin = { origin.X, origin.Y, origin.Z }
        preset.sources = {}
        for _, source in ipairs(field.sources) do
            local point = frame:VectorToWorldSpace(Vector3.new(unpack(source)))
            table.insert(preset.sources, { point.X, point.Y, point.Z })
        end
    end
    local handle = AmbientField.create(root, preset, data.schema)
    handle:start()
    return { handle = handle, owner = owner }
end
local function update(dt)
    if stopped then
        return
    end
    elapsed += dt
    if elapsed < cfg.update_interval then
        return
    end
    local delta = elapsed
    elapsed = 0
    local world = workspace:FindFirstChild(cfg.world)
    local camera = workspace.CurrentCamera
    local tier = quality()
    local reduced = player:GetAttribute(cfg.reduced_motion_attribute) == true
    local count, sources = 0, 0
    for _, field in ipairs(cfg.fields) do
        local owner = world and resolve(world, field.owner_path)
        local item = handles[field.name]
        if item and (item.owner ~= owner or item.handle.root.Parent == nil) then
            item.handle:destroy()
            handles[field.name] = nil
            item = nil
        end
        if owner and not item then
            item = attach(field, owner)
            handles[field.name] = item
        end
        if item then
            if camera then
                item.handle:update(delta, camera.CFrame.Position, tier, reduced)
            else
                item.handle:update(delta, Vector3.zero, "off", reduced)
            end
            count += 1
            sources += item.handle:status().sources
        end
    end
    root:SetAttribute("ActiveFields", count)
    root:SetAttribute("AuthoredSources", sources)
    root:SetAttribute("Quality", tier)
    root:SetAttribute("ReducedMotion", reduced)
end
connections[#connections + 1] = RunService.Heartbeat:Connect(update)
connections[#connections + 1] = script.Destroying:Connect(cleanup)
connections[#connections + 1] = runtime.Destroying:Connect(cleanup)
connections[#connections + 1] = root.Destroying:Connect(cleanup)
]==]
    -- All dependencies/source values staged successfully before replacing prior installation.
    local oldRuntime = storage:FindFirstChild(cfg.runtime_root)
    local oldClient = starter:FindFirstChild(cfg.client_name)
    if oldRuntime then
        oldRuntime:Destroy()
    end
    if oldClient then
        oldClient:Destroy()
    end
    runtime.Parent = storage
    client.Parent = starter
    local oldMist = resolve(world, cfg.old_mist_path)
    if oldMist then
        local backup = game.ServerStorage:FindFirstChild(cfg.backup_root)
        if not backup then
            backup = Instance.new("Folder")
            backup.Name = cfg.backup_root
            backup.Parent = game.ServerStorage
        end
        if backup:FindFirstChild(oldMist.Name) then
            oldMist:Destroy()
        else
            oldMist.Parent = backup
        end
    end
    return {
        fields = #cfg.fields,
        hellMistSources = #bundle.presets.hell_pool_mist.sources,
        hellMistRate = bundle.presets.hell_pool_mist.rate,
        originalMistArchived = oldMist ~= nil,
        runtime = runtime:GetFullName(),
        client = client:GetFullName(),
        nativeVerification = "Pending Play: replacement count, appearance, quality/distance and cleanup",
    }
end
