local mergeConfig = loadModule("configs/merge_egg_prototype.lua")

return function()
    describe("Merge cross-place transit feedback", function()
        it("keeps the lifecycle, timing, copy, and role palettes config-owned", function()
            local cfg = mergeConfig.gate.transit_feedback
            expect(cfg.enabled).to.equal(true)
            expect(cfg.active_attribute).to.equal("MergePortalTransitActive")
            expect(cfg.role_attribute).to.equal("MergePortalTransitRole")
            expect(cfg.token_attribute).to.equal("MergePortalTransitToken")
            expect(cfg.request_delay_seconds > 0).to.equal(true)
            expect(cfg.timeout_seconds >= 20).to.equal(true)
            expect(cfg.arrival_fade_seconds > 0).to.equal(true)
            expect(cfg.roles.merge.title).to.equal("ENTERING MERGE")
            expect(cfg.roles.main.title).to.equal("RETURNING TO FARM & FIGHT")
            expect(cfg.roles.merge.primary == cfg.roles.main.primary).to.equal(false)
        end)

        it("defines a readable world effect without changing character collision", function()
            local cfg = mergeConfig.gate.transit_feedback
            expect(cfg.bubble.material).to.equal("ForceField")
            expect(cfg.bubble.minimum_diameter >= 8).to.equal(true)
            expect(cfg.orbit.count >= 10).to.equal(true)
            expect(cfg.particles.rate >= 20).to.equal(true)
            expect(cfg.world_label.max_distance <= 100).to.equal(true)
            expect(cfg.hud.height <= 80).to.equal(true)
            expect(cfg.teleport_screen.backdrop_transparency > 0).to.equal(true)
        end)

        it("starts feedback before TeleportAsync and clears every failure seam", function()
            local server = readFile("src/Server/Services/MergeEggPrototypeService.lua")
            local beginAt =
                server:find("function MergeEggPrototypeService:_beginPortalTransit", 1, true)
            local teleportAt = server:find("TeleportService:TeleportAsync(pending.placeId", 1, true)
            expect(beginAt).to.be.ok()
            expect(teleportAt).to.be.ok()
            expect(beginAt < teleportAt).to.equal(true)
            expect(server:find("TeleportService.TeleportInitFailed:Connect", 1, true)).to.be.ok()
            expect(server:find("teleport_pending", 1, true)).to.be.ok()
            expect(server:find("_clearPortalTransit(player, pending.token)", 1, true)).to.be.ok()
            expect(server:find("config.request_delay_seconds", 1, true)).to.be.ok()
            expect(server:find("self:_stepPortalTransits(os.clock())", 1, true)).to.be.ok()
        end)

        it("boots the client shield and carries a custom GUI through loading", function()
            local initSource = readFile("src/Client/init.client.lua")
            local source = readFile("src/Client/Systems/MergePortalTransitFX.lua")
            expect(initSource:find("Systems.MergePortalTransitFX", 1, true)).to.be.ok()
            expect(source:find("bubble.Shape = Enum.PartType.Ball", 1, true)).to.be.ok()
            expect(source:find('Instance.new("Highlight")', 1, true)).to.be.ok()
            expect(source:find('Instance.new("ParticleEmitter")', 1, true)).to.be.ok()
            expect(source:find("RunService.RenderStepped:Connect", 1, true)).to.be.ok()
            expect(source:find("TeleportService:SetTeleportGui", 1, true)).to.be.ok()
            expect(source:find("TeleportService:GetArrivingTeleportGui", 1, true)).to.be.ok()
            expect(source:find("TeleportService.TeleportInitFailed:Connect", 1, true)).to.be.ok()
            expect(source:find("Humanoid.WalkSpeed", 1, true)).never.to.be.ok()
            expect(source:find("CanCollide = true", 1, true)).never.to.be.ok()
        end)
    end)
end
