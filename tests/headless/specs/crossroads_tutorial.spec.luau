local Gate = loadModule("src/Shared/Game/CrossroadsTutorialGate.lua")
local Flow = loadModule("src/Shared/Game/CrossroadsIntroFlow.lua")
local config = loadModule("configs/crossroads_tutorial.lua")
local clips = loadModule("configs/crossroads_voice_assets.lua").clips
local Director = loadModule("src/Shared/Game/TutorialVoiceDirector.lua")
return function()
    describe("Crossroads onboarding", function()
        it("holds Farm before arrival attributes settle and throughout exploration", function()
            expect(Gate.pending(true, true, nil, nil)).to.equal(true)
            expect(Gate.pending(true, true, true, false)).to.equal(true)
            expect(Gate.pending(true, true, false, true)).to.equal(false)
            expect(Gate.pending(true, true, true, true)).to.equal(true)
            expect(Gate.pending(true, false, nil, nil)).to.equal(false)
            expect(Gate.pending(false, true, nil, nil)).to.equal(false)
        end)
        it("finishes the welcome before yielding an ordered angel/demon exchange", function()
            local f = Flow.new(config)
            local welcome = f:nextSequence()
            f:observe("hell")
            expect(welcome).to.equal(config.welcome)
            local exchange = f:nextSequence()
            local catalog = Director.catalog(config)
            expect(catalog[exchange[1]].speaker).to.equal("angel")
            expect(catalog[exchange[2]].speaker).to.equal("demon")
            expect(catalog[exchange[3]].speaker).to.equal("angel")
            expect(catalog[exchange[4]].speaker).to.equal("demon")
            f:observe("heaven")
            expect(exchange).to.equal(config.hell_handoff)
            expect(f:nextSequence()).to.equal(config.heaven_return)
            expect(f.owner).to.equal("angel")
        end)
        it("retains the demon across neutral ground without repeating exchanges", function()
            local f = Flow.new(config)
            f:nextSequence()
            f:observe("hell")
            f:nextSequence()
            f:observe("purgatory")
            expect(f:nextSequence()).to.equal(nil)
            expect(f.owner).to.equal("demon")
            f:observe("heaven")
            f:nextSequence()
            f:observe("hell")
            expect(f:nextSequence()).to.equal(nil)
            expect(f.owner).to.equal("demon")
        end)
        it("does not replay persisted welcome or exchange on rejoin", function()
            local f = Flow.new(config)
            f:sync({ welcome = true, hell_handoff = true, heaven_return = true })
            f:observe("hell")
            expect(f:nextSequence()).to.equal(nil)
            expect(f.owner).to.equal("demon")
            f:observe("heaven")
            expect(f:nextSequence()).to.equal(nil)
        end)
        it("keeps only the unvisited destination introduction", function()
            local farm = Flow.new(config)
            farm:sync({ farm_visited = true })
            farm:observe("hell")
            expect(farm:nextSequence()).to.equal(config.hell_handoff)
            farm:observe("heaven")
            expect(farm:nextSequence()).to.equal(nil)
            local siege = Flow.new(config)
            siege:sync({ siege_visited = true })
            expect(siege:nextSequence()).to.equal(config.welcome)
            siege:observe("hell")
            expect(siege:nextSequence()).to.equal(nil)
        end)
        it("is quiet after both destinations and ignores stale false snapshots", function()
            local f = Flow.new(config)
            f:sync({ farm_visited = true, siege_visited = true })
            f:sync({ farm_visited = false, siege_visited = false })
            f:observe("hell")
            expect(f:nextSequence()).to.equal(nil)
            f:observe("heaven")
            expect(f:nextSequence()).to.equal(nil)
        end)
        it("has recorded audio and captions for every sequence line", function()
            local catalog = Director.catalog(config)
            for _, sequence in ipairs({ config.welcome, config.hell_handoff, config.heaven_return }) do
                for _, cue in ipairs(sequence) do
                    expect(catalog[cue].text ~= "").to.equal(true)
                    expect(clips[cue].asset_id > 0).to.equal(true)
                    expect(clips[cue].seconds > 0).to.equal(true)
                end
            end
        end)
    end)
end
