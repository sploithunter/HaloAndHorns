local Lease = loadModule("src/Shared/Game/MergeOfflineLease.lua")
local config = loadModule("configs/merge_offline.lua")
local internal = loadModule("configs/internal_accounts.lua")
return function()
    describe("offline account fencing", function()
        it("uses a dedicated runtime with no online presentation or automatic claims", function()
            local runtime = readFile("src/Server/MergeOfflineRuntime.lua")
            local service = readFile("src/Server/Services/MergeOfflineService.lua")
            local progression = readFile("src/Server/Services/PlayerProgressionService.lua")
            local realm = readFile("src/Server/Services/MergeEggRealmBuilder.lua")
            expect(runtime:find("merge._automationService = nil", 1, true)).to.be.ok()
            expect(runtime:find("merge._activeByPlayer, merge._enteringByPlayer", 1, true)).to.be.ok()
            expect(service:find("RegisterBeforeProfileLoad", 1, true)).to.be.ok()
            expect(service:find("ProfileStore.New(self._data.ProfileStore.Name", 1, true)).to.be.ok()
            expect(service:find("self._presence:UpdateAsync", 1, true)).to.be.ok()
            expect(progression:find("player.OfflineActor == true", 1, true)).to.be.ok()
            expect(realm:find("bay.claimant ~= player", 1, true)).to.be.ok()
        end)
        it("validates production policy and excludes only the designated account", function()
            expect(Lease.validate(config)).to.equal(true)
            local seen = {}
            for _, id in ipairs(Lease.seeds(internal, config)) do
                seen[id] = true
            end
            expect(seen[3200870803]).to.equal(nil)
            expect(seen[864785140]).to.equal(true)
            expect(seen[3464611671]).to.equal(true)
            expect(config.studio_enabled).to.equal(true)
        end)
        it("allows exactly one worker and rejects stale renewals", function()
            local first = Lease.acquire(nil, "a", 0, 90)
            expect(Lease.acquire(first, "b", 1, 90)).to.equal(nil)
            expect(Lease.renew(first, "b", 2, 90)).to.equal(nil)
            local second = Lease.acquire(first, "b", 91, 90)
            expect(second.token).to.equal("b")
            expect(Lease.release(second, "a", 92, 60)).to.equal(nil)
            expect(Lease.renew(first, "a", 91, 90)).to.equal(nil)
        end)
        it("login fences an offline worker without allowing stale logout to clear it", function()
            local worker = Lease.acquire(nil, "worker", 0, 90)
            local online = Lease.online(worker, "session2", 1, 90)
            expect(Lease.renew(online, "worker", 2, 90)).to.equal(nil)
            expect(Lease.release(online, "session1", 3, 60)).to.equal(nil)
            local cooldown = Lease.release(online, "session2", 4, 60)
            expect(Lease.acquire(cooldown, "worker2", 63, 90)).to.equal(nil)
            expect(Lease.acquire(cooldown, "worker2", 64, 90).token).to.equal("worker2")
        end)
    end)
end
