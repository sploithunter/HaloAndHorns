local MergeCannonPreview = loadModule("src/Shared/Game/MergeCannonPreview.lua")
local config = loadModule("configs/merge_egg_prototype.lua")

return function()
    describe("MergeCannonPreview", function()
        it("reads the authored workshop fill and fov", function()
            local settings = MergeCannonPreview.settings(config.team.edge_towers.workshop_preview)
            expect(settings.fill).to.equal(0.9)
            expect(settings.fovDegrees).to.equal(35)
            expect(settings.ambient[1]).to.equal(168)
            expect(settings.lightColor[1]).to.equal(255)
            expect(settings.lightDirection[2]).to.equal(-0.8)
        end)

        it("looks along the shorter horizontal axis so the long side faces the camera", function()
            expect(MergeCannonPreview.lookAxis(10, 4)).to.equal("z")
            expect(MergeCannonPreview.visibleWidth(10, 4)).to.equal(10)
            expect(MergeCannonPreview.lookAxis(3, 8)).to.equal("x")
            expect(MergeCannonPreview.visibleWidth(3, 8)).to.equal(8)
            local lookX, lookZ = MergeCannonPreview.sideLook(1, 0, 0, -1, 10, 4)
            expect(lookX).to.equal(0)
            expect(lookZ).to.equal(-1)
            lookX, lookZ = MergeCannonPreview.sideLook(1, 0, 0, -1, 3, 8)
            expect(lookX).to.equal(1)
            expect(lookZ).to.equal(0)
        end)

        it("keeps the camera at bbox height", function()
            local x, y, z = MergeCannonPreview.cameraOffset(0, -1, 12)
            expect(x).to.equal(0)
            expect(y).to.equal(0)
            expect(z).to.equal(-12)
        end)

        it("frames each pane from its own aspect so two windows scale independently", function()
            local settings = MergeCannonPreview.settings(config.team.edge_towers.workshop_preview)
            local owned = MergeCannonPreview.fitDistance(10, 2, 1, settings.fovDegrees, settings.fill)
            local nextPane = MergeCannonPreview.fitDistance(10, 2, 2, settings.fovDegrees, settings.fill)
            expect(nextPane < owned).to.equal(true)
            local tighter = MergeCannonPreview.fitDistance(10, 2, 1, settings.fovDegrees, 0.7)
            expect(tighter > owned).to.equal(true)
        end)

        it("projects a world-aligned box as width x height for the camera", function()
            local width, height = MergeCannonPreview.projectedViewSize(10, 4, 3, 0, -1)
            expect(width).to.equal(10)
            expect(height).to.equal(4)
        end)
    end)
end
