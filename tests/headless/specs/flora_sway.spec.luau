local FloraSway = loadModule("src/Shared/Game/FloraSway.lua")
local floraConfig = loadModule("configs/flora.lua")

return function()
    describe("FloraSway.shouldSway", function()
        it("moves typed plants, trees, cacti, and fabric banners", function()
            expect(FloraSway.shouldSway("Flora_cloud_bush", "plant")).to.equal(true)
            expect(FloraSway.shouldSway("Flora_cloud_sapling", "tree")).to.equal(true)
            expect(FloraSway.shouldSway("RealmDecor_crystal_cactus", "cactus")).to.equal(true)
            expect(FloraSway.shouldSway("cloth_banner", "banner")).to.equal(true)
        end)

        it("leaves rocks and hard dressing still", function()
            expect(FloraSway.shouldSway("Flora_marble_pebble", "rock")).to.equal(false)
            expect(FloraSway.shouldSway("RealmDecor_pearl_quartz", nil)).to.equal(false)
            expect(FloraSway.shouldSway("heaven_diamond_altar", nil)).to.equal(false)
        end)

        it("honors authored non-flora kinds instead of guessing from their names", function()
            expect(FloraSway.shouldSway("Banner", "wall_decor")).to.equal(false)
            expect(FloraSway.shouldSway("oak_tree", "landmark")).to.equal(false)
            expect(FloraSway.shouldSway("heaven_compass_banner", nil)).to.equal(false)
        end)

        it("matches inferred flora by whole token instead of embedded text", function()
            expect(FloraSway.shouldSway("hell_infernal_crest", nil)).to.equal(false)
            expect(FloraSway.shouldSway("cherry_heaven_tree_1", nil)).to.equal(true)
            expect(FloraSway.shouldSway("crystal_bloom_012", nil)).to.equal(true)
        end)
    end)

    describe("FloraSway.sample", function()
        it("stays inside the configured amplitude", function()
            local amplitude = FloraSway.amplitude("pearl_tuft", "plant", floraConfig.sway)
            expect(amplitude > 0).to.equal(true)
            local sample = FloraSway.sample(1.5, 0.4, amplitude, FloraSway.speed(floraConfig.sway))
            expect(math.abs(sample.pitch) <= amplitude + 1e-9).to.equal(true)
            expect(math.abs(sample.roll) <= amplitude + 1e-9).to.equal(true)
        end)

        it("is deterministic for a shared time and phase", function()
            local first = FloraSway.sample(9, 1.2, 0.04, 1.15)
            local second = FloraSway.sample(9, 1.2, 0.04, 1.15)
            expect(second.pitch).to.equal(first.pitch)
            expect(second.roll).to.equal(first.roll)
        end)
    end)

    describe("flora sway wiring", function()
        it("keeps the client rustle nearby-only and off rocks", function()
            local client = readFile("src/Client/init.client.lua")
            local service = readFile("src/Server/Services/FloraService.lua")
            local clientSway = readFile("src/Client/Systems/FloraSway.lua")

            expect(floraConfig.sway.enabled).to.equal(true)
            expect(floraConfig.sway.radius).to.equal(80)
            expect(client:find("require(script.Systems.FloraSway).start()", 1, true)).to.be.ok()
            expect(service:find('clone:SetAttribute("FloraSway", sway)', 1, true)).to.be.ok()
            expect(clientSway:find("FloraSwayMath.radius(config)", 1, true)).to.be.ok()
        end)

        it("exposes a default-on Prop Effects setting", function()
            local clientSway = readFile("src/Client/Systems/FloraSway.lua")
            local gameApi = readFile("src/Server/Services/GameAPIService.lua")
            local settingsPanel = readFile("src/Client/UI/Menus/SettingsPanel.lua")

            expect(clientSway:find("result.propEffects ~= false", 1, true)).to.be.ok()
            expect(
                clientSway:find('callBus("settings.set", { propEffects = prefEnabled })', 1, true)
            ).to.be.ok()
            expect(gameApi:find("prefs.propEffects ~= false", 1, true)).to.be.ok()
            expect(gameApi:find("data.Settings.ClientPrefs.propEffects", 1, true)).to.be.ok()
            expect(settingsPanel:find('"Prop Effects"', 1, true)).to.be.ok()
            expect(settingsPanel:find("FloraSway.setEnabled(value)", 1, true)).to.be.ok()
        end)
    end)
end
