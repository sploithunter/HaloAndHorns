local roles = loadModule("configs/pet_roles.lua")
local icons = loadModule("configs/power_icons.lua")
local PetTargeting = loadModule("src/Shared/Game/PetTargeting.lua")
local SupportAura = loadModule("src/Shared/Game/SupportAura.lua")

describe("Layer 3 support balance", function()
    it("makes the Rare and Legendary focused buffs meaningfully different", function()
        expect(roles.support_auras.glory_mongoose.mult).to.equal(1.1667)
        expect(roles.support_auras.gloryscale_salamander.mult).to.equal(1.2)
        expect(roles.support_auras.obsidian_totem.mult).to.equal(0.85)
        expect(roles.support_auras.dread_mongoose.mult).to.equal(0.8)
        expect(roles.support_auras.ruinscale_salamander.mult).to.equal(0.75)
        expect(roles.support_auras.dreadbloom_sprite.mult).to.equal(0.75)
    end)

    it("keeps the Legendary tortoise's lower numbers only alongside area utility", function()
        expect(roles.support_auras.light_tortoise.fraction).to.equal(0.05)
        local obsidian = SupportAura.aurasFor("obsidian_tortoise", roles)
        expect(#obsidian).to.equal(2)
        expect(obsidian[1].kind).to.equal("curse")
        expect(obsidian[1].mult).to.equal(0.85)
        expect(obsidian[2].kind).to.equal("antiheal")
        expect(PetTargeting.auraScope(obsidian[2], roles)).to.equal("aura")
        expect(obsidian[2].radius).to.equal(12)
    end)

    it("widens suppression only for Mythical and Secret drain hybrids", function()
        expect(PetTargeting.auraScope(roles.support_auras.ash_ibis, roles)).to.equal("single")
        expect(PetTargeting.auraScope(roles.support_auras.dreadthorn_grovekeeper, roles)).to.equal(
            "aura"
        )
        local dragon = SupportAura.aurasFor("dreadglass_dragon", roles)
        expect(PetTargeting.auraScope(dragon[1], roles)).to.equal("targeted_aoe")
    end)

    it("uses the existing red heal-down art for drain and anti-heal", function()
        expect(icons.function_mark.by_kind.drain).to.equal("antiheal")
        expect(icons.function_mark.by_kind.antiheal).to.equal("antiheal")
        expect(icons.support_badge.drain.symbol).to.equal("plus_down")
        expect(icons.support_badge.antiheal.symbol).to.equal("plus_down")
        expect(icons.discFor("fire", "plus_down") ~= nil).to.equal(true)
    end)
end)
