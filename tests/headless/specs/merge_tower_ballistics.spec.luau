local Ballistics = loadModule("src/Shared/Game/MergeTowerBallistics.lua")

return function()
    describe("Merge tower spear ballistics", function()
        it("keeps the projectile on the endpoints", function()
            local x0, y0, z0 = Ballistics.point(10, 4, -2, 100, 2, 8, 14, 0)
            local x1, y1, z1 = Ballistics.point(10, 4, -2, 100, 2, 8, 14, 1)
            expect(x0).to.equal(10)
            expect(y0).to.equal(4)
            expect(z0).to.equal(-2)
            expect(x1).to.equal(100)
            expect(y1).to.equal(2)
            expect(z1).to.equal(8)
        end)

        it("peaks at the configured apex on a flat shot", function()
            local _x, y, _z = Ballistics.point(0, 5, 0, 80, 5, 0, 14, 0.5)
            expect(y).to.be.near(19, 1e-9)
        end)

        it("clamps alpha so overshoot still lands on the target", function()
            local x, y, z = Ballistics.point(0, 3, 0, 40, 1, 10, 12, 4)
            expect(x).to.equal(40)
            expect(y).to.equal(1)
            expect(z).to.equal(10)
        end)

        it("points the launch tangent up by four times the apex", function()
            local dx, dy, dz = Ballistics.launchDelta(0, 8, 0, 80, 2, 0, 14)
            expect(dx).to.equal(80)
            expect(dy).to.equal(50)
            expect(dz).to.equal(0)
        end)

        it("aims the barrel along local +X instead of LookVector", function()
            local rx, ry, rz, ux, uy, uz = Ballistics.barrelBasis(0, 0, 1)
            expect(rx).to.be.near(0, 1e-9)
            expect(ry).to.be.near(0, 1e-9)
            expect(rz).to.be.near(1, 1e-9)
            expect(uy).to.be.near(1, 1e-6)
            expect(math.abs(ux * rx + uy * ry + uz * rz)).to.be.near(0, 1e-6)
        end)

        it("rejects a target on the egg side of the breach", function()
            -- Heaven: gate +X, eggs -X from a breach at X=180.
            expect(Ballistics.gateSideDistance(200, 0, 180, 0, 1, 0)).to.be.near(20, 1e-9)
            expect(Ballistics.onGateSide(200, 0, 180, 0, 1, 0, 2)).to.equal(true)
            expect(Ballistics.onGateSide(170, 0, 180, 0, 1, 0, 2)).to.equal(false)
            expect(Ballistics.onGateSide(179, 0, 180, 0, 1, 0, 2)).to.equal(true)
            local mx, mz = Ballistics.midpoint(180, -200, 200, -200)
            expect(mx).to.equal(190)
            expect(mz).to.equal(-200)
        end)

        it("grows and fades a quiet ability bloom", function()
            expect(Ballistics.bloomScale(0, 1.2, 2)).to.be.near(1.2, 1e-9)
            expect(Ballistics.bloomScale(1, 1.2, 2)).to.be.near(2.4, 1e-9)
            expect(Ballistics.bloomFade(0)).to.equal(0)
            expect(Ballistics.bloomFade(1)).to.equal(1)
        end)

        it("lurches up then settles on a short fire recoil", function()
            expect(Ballistics.recoilHeight(0, 0.2, 0.32, 0.03)).to.be.near(0, 1e-9)
            expect(Ballistics.recoilHeight(1, 0.2, 0.32, 0.03)).to.be.near(0, 1e-9)
            local peak = Ballistics.recoilHeight(0.32, 0.2, 0.32, 0)
            expect(peak).to.be.near(0.2, 1e-9)
            local rising = Ballistics.recoilHeight(0.16, 0.2, 0.32, 0)
            local falling = Ballistics.recoilHeight(0.66, 0.2, 0.32, 0)
            expect(rising > 0).to.equal(true)
            expect(falling > 0).to.equal(true)
            expect(rising < peak).to.equal(true)
            expect(falling < peak).to.equal(true)
        end)

        it("flattens turret yaw so the chassis never pitches", function()
            local x, y, z = Ballistics.planarYaw(12, 40, -5)
            expect(y).to.equal(0)
            expect(x).to.be.near(12 / math.sqrt(12 * 12 + 25), 1e-9)
            expect(z).to.be.near(-5 / math.sqrt(12 * 12 + 25), 1e-9)
        end)
    end)
end
