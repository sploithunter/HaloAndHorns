local cfg = loadModule("configs/profile_persistence.lua")
return function()
    describe("profile save coordination contracts", function()
        it("coalesces routine mutations without delaying critical ownership requests", function()
            expect(cfg.ordinary_debounce_seconds).to.equal(60)
            expect(cfg.critical_debounce_seconds < cfg.ordinary_debounce_seconds).to.equal(true)
            expect(cfg.auto_save_seconds).to.equal(60)
        end)
        it("never turns a timeout into a second writer or a successful acknowledgement", function()
            local source = readFile("src/Server/Services/DataService.lua")
            local first = assert(source:find("task.delay(SAVE_CONFIRM_TIMEOUT_SECONDS", 1, true))
            local last = assert(source:find("function DataService:LoadProfile", first, true))
            local timeout = source:sub(first, last - 1)
            expect(timeout:find("inFlight = false", 1, true)).to.equal(nil)
            expect(timeout:find("_saveProfileNow(", 1, true)).to.equal(nil)
            expect(timeout:find("lastConfirmedRequestId =", 1, true)).to.equal(nil)
            expect(source:find("function DataService:_startAutoSaveLoop", 1, true)).to.equal(nil)
        end)
        it(
            "checks persisted request identity and preserves mutations made during a save",
            function()
                local source = readFile("src/Server/Services/DataService.lua")
                expect(source:find("savedData.Persistence.lastRequestToken == token", 1, true)).to.be.ok()
                expect(source:find("saveState.dirtyRevision > revision", 1, true)).to.be.ok()
                expect(source:find("saveState.afterSaveConnection:Disconnect()", 1, true)).to.be.ok()
            end
        )
    end)
end
