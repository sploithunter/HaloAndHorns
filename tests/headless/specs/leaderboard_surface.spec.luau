local config = loadModule("configs/leaderboards.lua")
local Schemas = loadModule("src/Shared/ConfigSchemas.lua")

return function()
    describe("Recovered leaderboard surface styling", function()
        it("keeps canvas and readable fonts in config", function()
            expect(config.surface.canvas[1]).to.equal(1400)
            expect(config.surface.canvas[2]).to.equal(960)
            expect(config.surface.title_font).to.equal("SourceSansBold")
            expect(config.surface.body_font).to.equal("SourceSans")
            expect(Schemas.validate("leaderboards", config)).to.equal(true)
        end)
        it("uses the same config in runtime boards and the authoring script", function()
            local service = readFile("src/Server/Services/LeaderboardBoardService.lua")
            local stamp = readFile("scripts/studio/place_challenge_boards.luau")
            expect(service:find("self._config.surface.canvas", 1, true)).to.be.ok()
            expect(service:find("self._config.surface.title_font", 1, true)).to.be.ok()
            expect(service:find("self._config.surface.body_font", 1, true)).to.be.ok()
            expect(stamp:find("Configs.leaderboards).surface", 1, true)).to.be.ok()
            expect(service:find("Enum.Font.Gotham", 1, true)).to.equal(nil)
            expect(stamp:find("Enum.Font.Gotham", 1, true)).to.equal(nil)
            expect(config.publication.hide_internal_accounts).to.equal(true)
            expect(config.publication.studio_write_global).to.equal(false)
        end)
    end)
end
